#!/usr/bin/env bun

import { existsSync, readFileSync, writeFileSync } from "node:fs";

const args = process.argv.slice(2);
const outputIndex = args.indexOf("-o");
const source = args.at(-1);

if (
  args.length === 5 &&
  args[0] === "-c" &&
  args[1] === "icns" &&
  outputIndex === 2 &&
  source &&
  existsSync(source)
) {
  const files = [
    ["icp4", "icon_16x16.png"],
    ["icp5", "icon_32x32.png"],
    ["icp6", "icon_32x32@2x.png"],
    ["ic07", "icon_128x128.png"],
    ["ic08", "icon_256x256.png"],
    ["ic09", "icon_512x512.png"],
    ["ic10", "icon_512x512@2x.png"],
  ];
  const chunks = files.map(([type, filename]) => {
    const png = readFileSync(`${source}/${filename}`);
    const header = Buffer.alloc(8);
    header.write(type, 0, 4, "ascii");
    header.writeUInt32BE(png.length + header.length, 4);
    return Buffer.concat([header, png]);
  });
  const header = Buffer.alloc(8);
  header.write("icns", 0, 4, "ascii");
  header.writeUInt32BE(
    header.length + chunks.reduce((size, chunk) => size + chunk.length, 0),
    4,
  );
  writeFileSync(args[outputIndex + 1], Buffer.concat([header, ...chunks]));
  process.exit(0);
}

const result = Bun.spawnSync(["/usr/bin/iconutil", ...args], {
  stdin: "inherit",
  stdout: "inherit",
  stderr: "inherit",
});
process.exit(result.exitCode);
